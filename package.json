{
  "name": "xabor-agent",
  "version": "1.0.0",
  "description": "Agente de pedidos para Restaurante Xabor",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "chat": "node src/agent/chat-test.js",
    "mesero:eval": "node scripts/mesero-eval.mjs",
    "mesero:replay": "node test/replay-mesero.mjs",
    "mesero:tools": "node test/fase-agente-tools.mjs",
    "test:continuidad": "node test/fase-agente-continuidad-determinista.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:financiero": "node scripts/release-gate-financiero.mjs",
    "test:incident": "node scripts/predeploy-check-incidentes.mjs && node test/fase-agente-continuidad-determinista.mjs",
    "ai:loop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-loop.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@aws-sdk/client-s3": "^3.685.0",
    "@aws-sdk/s3-request-presigner": "^3.685.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.3.6",
    "file-type": "^19.6.0",
    "node-forge": "^1.3.1",
    "pdfjs-dist": "^4.7.76",
    "pg": "^8.12.0",
    "puppeteer": "^23.9.0",
    "sharp": "^0.35.3",
    "twilio": "^5.13.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "puppeteer@23.11.1": true
  }
}
