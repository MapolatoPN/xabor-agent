+// SOLO PARA LA PRUEBA DE CUTOVER P0-11 FASE 3 -- local al worktree OLD,
+// NUNCA comiteado. Replica EXACTAMENTE la secuencia real de
+// src/channels/whatsapp-meta.js (registrarPedido -> guardarPedidoProgramado
+// -> eliminarPedido) para poder disparar un pedido programado sin simular
+// un chat de WhatsApp completo. No reimplementa logica de negocio: llama a
+// las mismas funciones reales, sin modificarlas.
+app.post('/test/pedido-programado-p011', requireAdminSeguro, requireModulo('pos'), async (req, res) => {
+  const programadoPara = req.body?.programadoPara;
+  if (!programadoPara) return res.status(400).json({ error: 'programadoPara requerido' });
+  const ordenPrueba = {
+    cliente: { nombre: 'Cliente Prueba P011', telefono: '8781234999' },
+    modalidad: 'entrega a domicilio',
+    items: [{ nombre: 'Producto P011', cantidad: 1, precio_unitario: 200, notas: '' }],
+    subtotal: 200, costo_envio: 0, descuento: 0, total: 200,
+    canal: 'prueba_admin', negocioId: req.negocioId,
+    programado_para: programadoPara,
+  };
+  try {
+    const pedido = await registrarPedido(ordenPrueba, 'prueba_admin');
+    await guardarPedidoProgramado(pedido.id, pedido, programadoPara);
+    await eliminarPedido(pedido.id, pedido.negocioId);
+    res.json({ ok: true, pedido });
+  } catch (e) {
+    console.error('[server] Error en /test/pedido-programado-p011:', e.message);
+    res.status(500).json({ error: e.message });
+  }
+});
